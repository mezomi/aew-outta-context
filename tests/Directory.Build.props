<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Every test project: xUnit v3 + Shouldly, AAA tests named Method_Scenario_ExpectedResult. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Test method names use underscores (Method_Scenario_Expected) on purpose. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <Using Include="Shouldly" />
    <Using Include="CSharpFunctionalExtensions" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsTestKit)' != 'true'">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
